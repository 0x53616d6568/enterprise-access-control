# Face Recognition Microservice Configuration

# Flask
DEBUG=False
FACE_SERVICE_PORT=5000
FACE_SERVICE_HOST=0.0.0.0

# InsightFace Model
ARCFACE_MODEL=buffalo_s
ARCFACE_DEVICE=-1

# Security - Must match backend's FACE_SERVICE_API_KEY
FACE_SERVICE_API_KEY=sk-face-xyz123

# Embedding Settings
SIMILARITY_THRESHOLD=0.6

# Face Database
FACE_DB_PATH=./face_database

# Database Configuration
# Note: DB_PASSWORD must be set via environment variables in production
DB_HOST=enterprise-access-control-sameh11-9619.e.aivencloud.com
DB_PORT=25223
DB_USER=avnadmin
# DB_PASSWORD should be set as env var in Render/production
DB_NAME=enterprise-access-control