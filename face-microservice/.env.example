# Face Recognition Microservice Configuration

# Flask Server
DEBUG=False
FACE_SERVICE_HOST=0.0.0.0
FACE_SERVICE_PORT=5000

# InsightFace Model
# Options: buffalo_l (large, best accuracy), buffalo_m (medium), buffalo_s (small, fastest)
ARCFACE_MODEL=buffalo_l

# Device: 0 for GPU (requires CUDA), -1 for CPU
ARCFACE_DEVICE=-1

# Face matching threshold (0-1). Higher = stricter matching
SIMILARITY_THRESHOLD=0.6

# Face database path (where embeddings are stored)
FACE_DB_PATH=./face_database

# API Key for authentication
FACE_SERVICE_API_KEY=your-secret-key-change-in-production

# Logging
LOG_LEVEL=INFO
