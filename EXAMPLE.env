# Enterprise Access Control - Backend Configuration
# EXAMPLE FILE - Replace placeholders with your actual values
# DO NOT COMMIT ACTUAL CREDENTIALS TO GIT

# Server
PORT=3000
NODE_ENV=production

# Database (Aiven Cloud)
DB_HOST=your-instance-name.e.aivencloud.com
DB_PORT=25223
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=enterprise-access-control

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_generate_new_one
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_generate_new_one
JWT_REFRESH_EXPIRES_IN=7d

# Pi Communication
PI_API_KEY=your_pi_secret_key_here

# Face Recognition Microservice
FACE_SERVICE_URL=https://your-username-face-model.hf.space
FACE_SERVICE_API_KEY=sk-face-your-actual-key

# Face recognition threshold
FACE_CONFIDENCE_THRESHOLD=0.65

# MQTT Configuration (HiveMQ Cloud)
MQTT_BROKER=mqtts://bb9f7b883ac247ceb390c4c532330999.s1.eu.hivemq.cloud:8883
MQTT_BROKER_URL=mqtts://bb9f7b883ac247ceb390c4c532330999.s1.eu.hivemq.cloud:8883
MQTT_USER=sameh
MQTT_USERNAME=sameh
MQTT_PASSWORD=Samehsameh1020
MQTT_TLS_INSECURE=true

# Token Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_256_bit_encryption_key_for_tokens_here

# PC Door Station Configuration
BACKEND_HOST=enterprise-access-control-x.onrender.com
BACKEND_PORT=443
BACKEND_PROTOCOL=https
BACKEND_VERIFY_URL=https://enterprise-access-control-x.onrender.com/api/mqtt/request
MQTT_REQUEST_TOPIC=doors/+/access/request
MQTT_RESPONSE_TOPIC=doors/{door_id}/access/response/{request_id}
MQTT_CLIENT_ID=pc-door-station
HF_SPACE_URL=https://your-username-face-model.hf.space
HF_SPACE_API_KEY=
CAMERA_INDEX=0
PREVIEW_TITLE=SecureApp Door Station
FACE_THRESHOLD=0.60
