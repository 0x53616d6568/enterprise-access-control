# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=enterprise_access_control

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRES_IN=7d

# Pi communication
PI_API_KEY=your_pi_secret_key_change_this

# Face Recognition Microservice
# URL where the Python microservice is running (Raspberry Pi, Docker, etc.)
FACE_SERVICE_URL=http://localhost:5000
# Must match FACE_SERVICE_API_KEY in microservice .env
FACE_SERVICE_API_KEY=your-secret-key-change-in-production

# Face recognition threshold
FACE_CONFIDENCE_THRESHOLD=0.65

